@model List<Drivers>

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2>Shuttles Index Page</h2>
        </div>
        <div class="col-6 text-end">
            <a href="/Drivers/Add" class="btn btn-outline-primary">
                Add New Driver
            </a>
        </div>
    </div>
</div>


<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Driver Id</th>
            <th>Name</th>
            <th>LicenseNo</th>
            <th>Contact</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@Model[i].DriverId</td>
                <td>@Model[i].Name</td>
                <td>@Model[i].LicenseNo</td>
                <td>@Model[i].Contact</td>
                <td>

                    <a href="/Drivers/Edit/@Model[i].DriverId"
                       class="btn btn-outline-warning btn-sm">
                        Edit
                    </a>

                    <a href="/Drivers/Delete/@Model[i].DriverId"
                       class="btn btn-outline-danger btn-sm">
                        Delete
                    </a>

                </td>
            </tr>
        }

    </tbody>
</table>
</div>

