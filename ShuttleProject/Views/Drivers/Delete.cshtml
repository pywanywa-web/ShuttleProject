@model ShuttleProject.Models.Drivers

<form method="post" asp-action="Delete">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="DriverId" />
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2>Delete Driver</h2>
            <hr />
        </div>
        <div class="mb-3">
            <label for="Name" class="form-label">Name</label>
            <input class="form-control" disabled asp-for="Name" />
        </div>
       

        <div class="mb-3">
            <label for="LicenseNo" class="form-label">License Number</label>
            <input class="form-control" disabled asp-for="LicenseNo" />
        </div>
        <div class="mb-3">
            <label for="Contact" class="form-label">Contact</label>
            <input class="form-control" disabled asp-for="Contact" />
        </div>

        <button class="btn btn-outline-danger">Submit</button>

        <a href="/Drivers/Index" class="btn btn-outline-warning">
            Back to list
        </a>

    </div>
</form>