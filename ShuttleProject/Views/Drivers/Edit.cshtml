@model ShuttleProject.Models.Data.MonitoringSystem.Driver

<form asp-action="Edit" method="post">
  <input type="hidden" asp-for=DriverId />
   <div class="border p-3 mt-4">
      <div class="row pb-2">
          <h1>Edit Driver Profile</h1>
          <hr />
                
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LicenseNo" class="form-label">License Number</label>
                <input asp-for="LicenseNo" class="form-control" />
                <span asp-validation-for="LicenseNo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Contact" class="form-label">Contact</label>
                <input asp-for="Contact" class="form-control" />
                <span asp-validation-for="Contact" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button class="btn btn-outline-dark">Submit</button>
                
                <a asp-action="Index" class="btn btn-outline-success">
                    Back to List
                </a>
             </div>
      </div>
</form>