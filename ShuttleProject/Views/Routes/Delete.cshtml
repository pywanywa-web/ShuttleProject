@model ShuttleProject.Models.Routes

<form method="post" asp-action="Delete">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RouteId" />
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2>Delete Route</h2>
            <hr />
        </div>

        <div class="mb-3">
            <label for="RouteId" class="form-label">Route Id</label>
            <input class="form-control" disabled asp-for="RouteId" />
        </div>

        <div class="mb-3">
            <label for="RouteName" class="form-label">Route Name</label>
            <input class="form-control" disabled asp-for="RouteName" />
        </div>
        <div class="mb-3">
            <label for="StartPoint" class="form-label">Start Point</label>
            <input class="form-control" disabled asp-for="StartPoint" />    
       </div>
        <div class="mb-3">
            <label for="EndPoint" class="form-label">End Point</label>
            <input class="form-control" disabled asp-for="EndPoint" />  
        </div>

        <button class="btn btn-outline-danger">Submit</button>

        <a asp-controller="Routes" asp-action="Index" class="btn btn-outline-warning">
            Back to list
        </a>

    </div>
</form>
