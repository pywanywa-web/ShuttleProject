@model ShuttleProject.Models.Data.MonitoringSystem.Trip

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2>Add Trip</h2>
            <hr />
        </div>

        <div class="mb-3">
            <label for="TripId" class="form-label">Trip Id</label>
            <input class="form-control" asp-for="TripId" />
        </div>

        @* <div class="mb-3">
            <label for="ShuttleId" class="form-label">Shuttle Id</label>
            <select asp-for="ShuttleId" class="form-control" asp-items="@(ViewData["Shutles"] as IEnumerable<SelectListItem>)">
                <option value="">-- Select shuttleId --</option>
            </select>
            <span asp-validation-for="ShuttleId" class="text-danger"></span>
        </div> *@

        <div class="mb-3">
            <label for="RouteId" class="form-label">Route Id</label>
            <select asp-for="RouteId" class="form-control" asp-items="@(ViewData["Routes"] as IEnumerable<SelectListItem>)">
                <option value="">-- Select RouteId --</option>
            </select>
            <span asp-validation-for="RouteId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="DepartureTime" class="form-label">DepartureTime</label>
            <input class="form-control" asp-for="DepartutreTime" />
        </div>

        <div class="mb-3">
            <label for="ArrivalTime" class="form-label">ArrivalTime</label>
            <input class="form-control" asp-for="ArrivalTime" />
        </div>

        <div class="mb-3">
            <label for="TripStatus" class="form-label">TripStatus</label>
            <input class="form-control" asp-for="TripStatus" />
        </div>

        <div class="mb-3">
            <label for="PassengerId" class="form-label">Passenger</label>
            <select asp-for="PassengerId" class="form-control" asp-items="@(ViewData["Passengers"] as IEnumerable<SelectListItem>)">
                <option value="">-- Select passenger --</option>
            </select>
            <span asp-validation-for="PassengerId" class="text-danger"></span>
        </div>

        <button class="btn btn-outline-primary">Submit</button>
        <a href="/Trip/Index" class="btn btn-outline-warning">Back to list</a>
    </div>
</form>


