@model ShuttleProject.Models.Data.MonitoringSystem.Shuttle

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ShuttleId" /> 
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2>Delete Shuttle</h2>
            <hr />
        </div>

        <div class="mb-3">
            <label for="ShuttleId" class="form-label">Shuttle Id</label>
            <input class="form-control" disabled asp-for="ShuttleId" />
        </div>
        <div class="mb-3">
            <label for="PlateNumber" class="form-label">Plate Number</label>
            <input class="form-control" disabled asp-for="PlateNumber" />
        </div>

        <div class="mb-3">
            <label for="Capacity" class="form-label">Capacity</label>
            <input class="form-control" disabled asp-for="Capacity" />
        </div>
        <div class="mb-3">
            <label for="Status" class="form-label">Status</label>
            <input class="form-control" disabled asp-for="Status" />
        </div>

        <button class="btn btn-outline-danger">Submit</button>

        <a asp-controller="Shuttles" asp-action="Index" class="btn btn-outline-warning">Back to list</a>
    </div>
</form>