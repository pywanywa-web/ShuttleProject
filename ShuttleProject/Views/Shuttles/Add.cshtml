@model ShuttleProject.Models.Shuttles
@using Microsoft.AspNetCore.Mvc.Rendering
        
<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2>Add Shuttle</h2>
            <hr />
        </div>

        <div class="mb-3">
            <label for="ShuttleId" class="form-label">Shuttle Id</label>
            <input class="form-control" asp-for="ShuttleId" />
        </div>

        <div class="mb-3">
            <label for="PlateNumber" class="form-label">Plate Number</label>
            <input class="form-control" asp-for="PlateNumber" />
        </div>

        <div class="mb-3">
            <label for="Status" class="form-label">Status</label>
            <input class="form-control" asp-for="Status" />
        </div>

        <div class="mb-3">
            <label for="Capacity" class="form-label">Capacity</label>
            <input class="form-control" asp-for="Capacity" />
        </div>

        <div class="mb-3">
            <label for="DriverId" class="form-label">Driver</label>
            <select asp-for="DriverId" class="form-control" asp-items="@(ViewData["Drivers"] as IEnumerable<SelectListItem>)">
                <option value="">-- Select driver --</option>
            </select>
            <span asp-validation-for="DriverId" class="text-danger"></span>
        </div>

        <button class="btn btn-outline-primary">Submit</button>
        <a href="/Shuttles/Index" class="btn btn-outline-warning">Back to list</a>
    </div>
</form>

