@model ShuttleProject.Models.ViewModel.ShuttleViewModel
@* @using Microsoft.AspNetCore.Mvc.Rendering *@
        
<form asp-action="Add" method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2>Add Shuttle</h2>
            <hr />
        

            <div class="mb-3">
                <label asp-for="ShuttleId" class="form-label">Shuttle Id</label>
                <input class="form-control" asp-for="ShuttleId" />
                <span asp-validation-for="ShuttleId" class="text-danger"></span>
            </div>

             <div class="mb-3">
                 <label asp-for="PlateNumber" class="form-label">Plate Number</label>
                 <input class="form-control" asp-for="PlateNumber" />
                <span asp-validation-for="PlateNumber" class="text-danger"></span>
             </div>

             <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <input class="form-control" asp-for="Status" />
                <span asp-validation-for="Status" class="text-danger"></span>

             </div>

             <div class="mb-3">
                 <label asp-for="Capacity" class="form-label">Capacity</label>
                 <input class="form-control" asp-for="Capacity" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
             </div>

            @* <div class="mb-3">
                <label asp-for="DriverId" class="form-label">Driver</label>
                <select asp-for="DriverId" class="form-control" asp-items="@(ViewData["Drivers"] as IEnumerable<SelectListItem>)">
                    <option value="">-- Select driver --</option>
                </select>
                <span asp-validation-for="DriverId" class="text-danger"></span>
            </div> *@

            <div class="mb-3">
                <button class="btn btn-outline-primary">Submit</button>
                <a asp-action="Index" class="btn btn-outline-warning">Back to list</a>
            </div>
        </div>
    </div>
</form>

