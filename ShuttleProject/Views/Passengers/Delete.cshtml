@model ShuttleProject.Models.Passengers

<form method="post">
    <input type="hidden" asp-for="PassengerId" />
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2>Delete Passenger</h2>
            <hr />
        </div>
        <div class="mb-3">
            <label for="Name" class="form-label">Name</label>
            <input class="form-control" disabled asp-for="Name" />
        </div>


        <div class="mb-3">
            <label for="Email" class="form-label">Email</label>
            <input class="form-control" disabled asp-for="Email" />
        </div>
        <div class="mb-3">
            <label for="Type" class="form-label">Type</label>
            <input class="form-control" disabled asp-for="Type" />
        </div>

        <button class="btn btn-outline-danger">Submit</button>

        <a href="/Passengers/Index" class="btn btn-outline-warning">
            Back to list
        </a>

    </div>
</form>
