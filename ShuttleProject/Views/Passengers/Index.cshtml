@model List<Passengers>
   


<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2>Passengers Index Page</h2>
        </div>
         @*  <div class="col-6 text-end">
            <a href="/Passengers/Filter" class="btn btn-outline-info">
                Filter Passengers
            </a> *@
            <div class="clo-6 text-end">
                <a href="/Passengers/Add" class="btn btn-outline-primary">
                Add New Passenger
                </a>
            </div>
    </div>
</div>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Passenger Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Type</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@Model[i].PassengerId</td>
                <td>@Model[i].Name</td>
                <td>@Model[i].Email</td>
                <td>@Model[i].Type</td>
                <td>

                    <a href="/Passengers/Edit/@Model[i].PassengerId"
                       class="btn btn-outline-warning btn-sm">
                        Edit
                    </a>

                    <a href="/Passengers/Delete/@Model[i].PassengerId"
                       class="btn btn-outline-danger btn-sm">
                        Delete
                    </a>

                </td>
            </tr>
        }

    </tbody>
</table>
